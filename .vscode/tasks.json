      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🖥️ Run App Admin Frontend (Vite)",
      "type": "npm",
      "script": "dev:app",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "⚡ Run Express Server Backend",
      "type": "npm",
      "script": "dev:server",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🛍️ Run Shopify Theme Dev",
      "type": "npm",
      "script": "theme:dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
