<section class="components-section section-wrap" id="components">
  <div class="section-heading compact">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow | default: '02 / CURATED HARDWARE' }}</span>
      <h2>
        {{ section.settings.title_line1 | default: 'Selected' }}<br>
        <em>{{ section.settings.title_line2 | default: 'components.' }}</em>
      </h2>
    </div>
    {%- if section.settings.collection != blank -%}
      <a class="text-link" href="{{ section.settings.collection.url }}">VIEW ALL COMPONENTS ↗</a>
    {%- else -%}
      <a class="text-link" href="{{ routes.collections_url }}">VIEW ALL COMPONENTS ↗</a>
    {%- endif -%}
  </div>

  <div class="product-grid">
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {%- capture tone -%}{%- cycle 'copper', 'silver', 'blue' -%}{%- endcapture -%}
        {% render 'product-card', product: product, tone: tone %}
      {%- endfor -%}
    {%- else -%}
      <!-- Demo curated hardware cards -->
      <article class="product-card">
        <div class="product-art copper">
          <span>GPU / GRAPHICS</span>
          <img src="{{ 'NVIDIA GeForce RTX 5080 Founders Edition_no_bg.png' | asset_url }}" alt="RTX 5080 Founders Edition" class="product-card-real-img" width="400" height="300" loading="lazy" style="max-height: 150px; max-width: 85%; object-fit: contain;">
        </div>
        <div class="product-info">
          <div>
            <span class="eyebrow">GPU / FEATURED</span>
            <h3>RTX 5080 Founders Edition</h3>
          </div>
          <strong>$1,199</strong>
        </div>
        <div class="product-specs">
          <span>16GB GDDR7</span>
          <span>360W DRAW</span>
          <span>304MM LENGTH</span>
        </div>
        <div class="product-card-footer">
          <a href="{{ routes.collections_url }}">VIEW PRODUCT <span>↗</span></a>
          <button type="button" class="text-button" data-open-builder data-select-category="GPU" data-select-id="gpu-5080" style="color: var(--amber)">ADD TO RIG +</button>
        </div>
      </article>

      <article class="product-card">
        <div class="product-art silver">
          <span>CPU / PROCESSOR</span>
          <img src="{{ 'AMD Ryzen 9 9950X_no_bg.png' | asset_url }}" alt="Ryzen 9 9950X" class="product-card-real-img" width="400" height="300" loading="lazy" style="max-height: 150px; max-width: 85%; object-fit: contain;">
        </div>
        <div class="product-info">
          <div>
            <span class="eyebrow">CPU / FEATURED</span>
            <h3>Ryzen 9 9950X</h3>
          </div>
          <strong>$649</strong>
        </div>
        <div class="product-specs">
          <span>AM5 SOCKET</span>
          <span>170W DRAW</span>
          <span>16 CORES / 32 THREADS</span>
        </div>
        <div class="product-card-footer">
          <a href="{{ routes.collections_url }}">VIEW PRODUCT <span>↗</span></a>
          <button type="button" class="text-button" data-open-builder data-select-category="CPU" data-select-id="cpu-9950x" style="color: var(--amber)">ADD TO RIG +</button>
        </div>
      </article>

      <article class="product-card">
        <div class="product-art blue">
          <span>MEMORY / DDR5</span>
          <img src="{{ 'Corsair Vengeance RGB 64 GB (2 x 32 GB) DDR5-6000 CL30 Memory_no_bg.png' | asset_url }}" alt="64GB DDR5-6000" class="product-card-real-img" width="400" height="300" loading="lazy" style="max-height: 150px; max-width: 85%; object-fit: contain;">
        </div>
        <div class="product-info">
          <div>
            <span class="eyebrow">RAM / FEATURED</span>
            <h3>64GB DDR5-6000 CL30</h3>
          </div>
          <strong>$209</strong>
        </div>
        <div class="product-specs">
          <span>2 × 32GB KIT</span>
          <span>AMD EXPO / XMP</span>
          <span>LOW LATENCY</span>
        </div>
        <div class="product-card-footer">
          <a href="{{ routes.collections_url }}">VIEW PRODUCT <span>↗</span></a>
          <button type="button" class="text-button" data-open-builder data-select-category="RAM" data-select-id="ram-64gb" style="color: var(--amber)">ADD TO RIG +</button>
        </div>
      </article>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Components",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "02 / CURATED HARDWARE"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading Line 1",
      "default": "Selected"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Heading Line 2",
      "default": "components."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Components"
    }
  ]
}
{% endschema %}
