<header class="site-header">
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} Home">
    {% render 'mark-icon' %}
    RIG<span>FORGE</span>
  </a>

  <nav class="desktop-nav" aria-label="Main Navigation">
    <a href="{{ routes.root_url }}#profiles">WORKLOADS</a>
    <a href="{{ routes.root_url }}#components">HARDWARE</a>
    <a href="{{ routes.root_url }}#workbench">TELEMETRY</a>
    <a href="{{ routes.root_url }}#builder" data-open-builder style="color: var(--amber); font-weight: 700;">+ BUILD RIG</a>
  </nav>

  <div class="header-actions">
    <a href="http://localhost:5173" target="_blank" rel="noopener noreferrer" style="font-size: 11px; font-family: var(--font-mono); font-weight: 700; color: var(--amber); border-color: rgba(217, 119, 6, 0.3);">
      ⚙ ADMIN
    </a>
    <a href="{{ routes.cart_url }}" aria-label="Cart">
      CART <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
    </a>
    <button class="mobile-menu" aria-label="Toggle menu" type="button">☰</button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
