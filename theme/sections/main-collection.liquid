<div class="catalog-header">
  <span class="eyebrow">CATALOG / ALL HARDWARE</span>
  <h1 class="page-title">{{ collection.title | default: 'All Components' }}</h1>
  <p>{{ collection.description | default: 'Browse our full 21-part hardware catalog with verified power envelopes, socket compatibility, thermal profiles, and high-refresh displays.' }}</p>

  <div class="filter-bar" data-catalog-filters>
    <button type="button" class="filter-chip active" data-filter="ALL">ALL HARDWARE (21)</button>
    <button type="button" class="filter-chip" data-filter="CPU">PROCESSORS (CPU)</button>
    <button type="button" class="filter-chip" data-filter="GPU">GRAPHICS (GPU)</button>
    <button type="button" class="filter-chip" data-filter="Motherboard">MOTHERBOARDS</button>
    <button type="button" class="filter-chip" data-filter="RAM">DDR5 RAM</button>
    <button type="button" class="filter-chip" data-filter="Cooler">COOLING</button>
    <button type="button" class="filter-chip" data-filter="Case">CHASSIS / CASES</button>
    <button type="button" class="filter-chip" data-filter="PSU">POWER SUPPLIES</button>
    <button type="button" class="filter-chip" data-filter="Display">MONITORS / DISPLAYS</button>
  </div>
</div>

<div class="section-wrap" style="padding-top: 40px;">
  <div class="product-grid" data-catalog-grid>
