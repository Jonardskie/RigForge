        "DeepCool AK620 Digital_no_bg.png": "{{ 'DeepCool AK620 Digital_no_bg.png' | asset_url }}",
        "Fractal Design North XL Mesh_no_bg.png": "{{ 'Fractal Design North XL Mesh_no_bg.png' | asset_url }}",
        "Lian Li O11 Vision_no_bg.png": "{{ 'Lian Li O11 Vision_no_bg.png' | asset_url }}",
        "Lian Li Vector V100R ATX Mid Tower Case_no_bg.png": "{{ 'Lian Li Vector V100R ATX Mid Tower Case_no_bg.png' | asset_url }}",
