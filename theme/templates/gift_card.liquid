{% layout none %}
{%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
  {{ content_for_header }}
  <style>
    body {
      background: #F4F7FB;
      color: #0F172A;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      text-align: center;
    }
    .giftcard-container {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 3rem 2.5rem;
      max-width: 480px;
      box-shadow: 8px 8px 24px rgba(195, 207, 224, 0.5), -8px -8px 24px rgba(255, 255, 255, 0.95);
    }
    .badge {
      display: inline-block;
      padding: 0.35rem 0.9rem;
      border-radius: 9999px;
      background: #FEF3C7;
      color: #D97706;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      margin-bottom: 1.25rem;
      border: 1px solid rgba(217, 119, 6, 0.2);
    }
    h1 {
      font-size: 2.25rem;
      font-weight: 800;
      margin: 0.5rem 0 1rem;
      color: #0F172A;
    }
    p {
      color: #64748B;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .code {
      font-family: 'JetBrains Mono', monospace, ui-monospace;
      font-size: 1.4rem;
      letter-spacing: 0.15em;
      background: #EDF2F7;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      margin: 1.75rem 0;
      border: 1.5px dashed #CBD5E1;
      color: #D97706;
      font-weight: 700;
      box-shadow: inset 2px 2px 5px rgba(195, 207, 224, 0.45);
    }
  </style>
</head>
<body>
  <div class="giftcard-container">
    <div class="badge">RIGFORGE GIFT CARD</div>
    <h1>{{ gift_card.balance | money }}</h1>
    <p>Use this code at checkout to redeem your gift card balance:</p>
    <div class="code">{{ gift_card.code | format_code }}</div>
    <p><a href="{{ shop.url }}" style="color: #D97706; text-decoration: none; font-weight: 700;">&larr; Return to Store</a></p>
  </div>
</body>
</html>
