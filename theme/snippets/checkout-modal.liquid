<div 
  id="mock-checkout-modal" 
  class="builder-backdrop" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="checkout-modal-title"
  hidden
>
  <div class="builder-panel" style="max-width: 680px; margin: 0 auto; max-height: 90vh; overflow-y: auto;">
    <header class="builder-header">
      <div>
        <span class="eyebrow">ORDER DISPATCH / CHECKOUT</span>
        <h2 id="checkout-modal-title">Secure Rig Checkout</h2>
      </div>
      <button type="button" class="icon-button" data-close-checkout aria-label="Close Checkout">&times;</button>
    </header>

    <div style="padding: 24px 32px;" id="checkout-form-view">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
        <div>
          <label style="display: block; font: 11px var(--font-mono); font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">CUSTOMER NAME</label>
          <input 
            type="text" 
            id="checkout-name" 
            value="Alex Rivers" 
            style="width: 100%; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); font: 13px var(--font-body); color: var(--text-main); background: #FFFFFF; box-shadow: var(--neu-sunken-sm);"
          >
        </div>
        <div>
          <label style="display: block; font: 11px var(--font-mono); font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">EMAIL NOTIFICATION</label>
          <input 
            type="email" 
            id="checkout-email" 
            value="alex.rivers@rigforge.io" 
            style="width: 100%; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); font: 13px var(--font-body); color: var(--text-main); background: #FFFFFF; box-shadow: var(--neu-sunken-sm);"
          >
        </div>
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font: 11px var(--font-mono); font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">SHIPPING DESTINATION</label>
        <input 
          type="text" 
          id="checkout-address" 
          value="742 Precision Blvd, Suite 400, San Francisco, CA 94107" 
          style="width: 100%; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); font: 13px var(--font-body); color: var(--text-main); background: #FFFFFF; box-shadow: var(--neu-sunken-sm);"
        >
      </div>

      <!-- Payment Method Selection -->
      <div style="margin-bottom: 24px;">
        <label style="display: block; font: 11px var(--font-mono); font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">PAYMENT SIMULATION</label>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" class="filter-chip active" style="font-size: 11px; padding: 6px 14px;">● TEST CARD (4242)</button>
          <button type="button" class="filter-chip" style="font-size: 11px; padding: 6px 14px;">SHOP PAY</button>
          <button type="button" class="filter-chip" style="font-size: 11px; padding: 6px 14px;">AFFIRM 0% APR</button>
        </div>
      </div>

      <!-- Manifest Summary Widget -->
      <div style="background: var(--bg-sunken); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 18px 20px; margin-bottom: 24px; box-shadow: var(--neu-sunken-sm);" id="checkout-summary-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <span style="font: 11px var(--font-mono); font-weight: 700; color: var(--text-muted);" id="checkout-summary-id">BUILD ID: RF-8492</span>
          <span style="font: 11px var(--font-mono); color: var(--green); font-weight: 700;">✓ SOCKET & CLEARANCE VERIFIED</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <span style="font-size: 14px; color: var(--text-body);">Total Due (Inc. 3-Year Assembly Guarantee):</span>
          <strong style="font-family: var(--font-head); font-size: 26px; color: var(--amber);" id="checkout-summary-price">$2,934.00</strong>
        </div>
      </div>

      <button 
        type="button" 
        id="btn-dispatch-order" 
        class="primary-button" 
        style="width: 100%; height: 52px; font-size: 12px;"
      >
        PLACE ORDER & DISPATCH TO MERCHANT ADMIN <span>↗</span>
      </button>
      
      <p style="text-align: center; color: var(--text-muted); font: 10px var(--font-mono); margin-top: 12px;">
        🔒 Direct integration with RigForge API backend & Database Inspector
      </p>
    </div>

    <!-- Success Confirmation State -->
    <div style="padding: 40px 32px; text-align: center; display: none;" id="checkout-success-view">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--green-surface); border: 2px solid var(--green); color: var(--green); font-size: 30px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: var(--neu-raised-sm);">
        ✓
      </div>
      <span class="eyebrow" style="background: var(--green-surface); color: var(--green); border-color: rgba(5, 150, 105, 0.2);">DISPATCHED TO MERCHANT BACKEND</span>
      <h2 style="font-family: var(--font-head); font-size: 28px; margin: 12px 0; color: var(--text-main);" id="checkout-success-order-num">Order #RF-8492 Confirmed!</h2>
      <p style="color: var(--text-muted); max-width: 440px; margin: 0 auto 24px; font-size: 14px;">
        Your custom rig order has been validated, power budget recorded, and stock inventory automatically decremented in the database.
      </p>

      <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a 
          href="http://localhost:5173" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="primary-button" 
          style="min-height: 48px; padding: 0 24px; font-size: 11px;"
        >
          VIEW IN MERCHANT ADMIN (PORT 5173) <span>↗</span>
        </a>
        <button 
          type="button" 
          class="outline-button" 
          data-close-checkout 
          style="min-height: 48px; padding: 0 24px; font-size: 11px;"
        >
          CONTINUE BROWSING
        </button>
      </div>
    </div>
  </div>
</div>
