{
  "name": "rig-forge-platform",
  "version": "1.0.0",
  "description": "RigForge — Custom PC Configurator Storefront & Embedded Merchant Admin Platform",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:local": "npx concurrently -n \"APP-ADMIN,SERVER\" -c \"magenta,green\" \"npm run dev:app\" \"npm run dev:server\"",
    "dev:theme": "shopify theme dev --store rigforge-zh662akf.myshopify.com --path=theme",
    "dev:app": "npm run dev --prefix app-frontend",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npx concurrently -n \"THEME,APP-ADMIN,SERVER\" -c \"cyan,magenta,green\" \"npm run theme:dev\" \"npm run dev:app\" \"npm run dev:server\"",
    "theme:dev": "shopify theme dev --store rigforge-zh662akf.myshopify.com --path=theme",
    "theme:push": "shopify theme push --store rigforge-zh662akf.myshopify.com --path=theme",
    "theme:pull": "shopify theme pull --store rigforge-zh662akf.myshopify.com --path=theme",
    "theme:check": "shopify theme check --path=theme",
    "build:app": "npm run build --prefix app-frontend",
    "build:server": "npm run build --prefix server",
    "build:all": "npm run build:app"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
